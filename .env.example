# ------------------------------------------------------------------
# Beirut Dishes — Environment Configuration
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored; never commit real secrets.
# ------------------------------------------------------------------

# Database connection string (server-side only, NOT exposed to the browser).
# Used by the reservation backend once you switch off demo storage.
# Supabase example: postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL=

# Public site URL — used for SEO canonical links, Open Graph and JSON-LD schema.
# No trailing slash. Example: https://beirutdishes.ma
NEXT_PUBLIC_SITE_URL=https://beirutdishes.ma

# WhatsApp number in international format, digits only (no + or spaces).
# NOTE: values read in the browser MUST be prefixed with NEXT_PUBLIC_.
# The reservation/contact links are client-side, so use the PUBLIC variant.
WHATSAPP_NUMBER=212669090588
NEXT_PUBLIC_WHATSAPP_NUMBER=212669090588

# ------------------------------------------------------------------
# Reservation backend switch (optional)
# demo     → in-memory storage (default, no database required)
# supabase → persist reservations via Supabase (requires the vars below)
# ------------------------------------------------------------------
NEXT_PUBLIC_RESERVATION_BACKEND=demo

# Supabase (only needed when NEXT_PUBLIC_RESERVATION_BACKEND=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side privileged key — keep secret, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
